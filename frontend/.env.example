# Point the app at the Python backend.
#
# Nothing secret belongs here: every VITE_ value is compiled into the bundle
# and is readable by anyone who opens the site.
#
# Set it, and every screen the backend covers — company settings and
# credentials, channels, calls, recordings, messages, Google Drive, exports —
# talks to the real API. The screens it does not cover yet say "coming soon"
# rather than showing sample data.
#
# Leave it unset, and the app runs entirely on its in-memory fixtures. That is
# how the marketing site and the design were built, and it still works offline.
VITE_API_URL=http://localhost:8000

# Firebase: who is signed in, separate from which company's API key the app
# ends up holding (see lib/firebase.ts). This whole object is public by
# design — Firebase's security model is server-side token verification and
# rules, not keeping this value secret — so it belongs here same as above.
# Get these from Firebase console → Project settings → your web app's config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
