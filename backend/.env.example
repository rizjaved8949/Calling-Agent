# Calling Agent API — the platform operator's own configuration.
#
# Only what must be set. Everything with a sensible default lives in
# app/config.py, so this file stays short enough to read and a value appearing
# here means somebody chose it.
#
# Nothing a COMPANY decides belongs here. Their greeting, language, voice,
# persona, Meta app and carrier account are entered on their settings screen
# and sealed into their own row.
#
# Copy to .env and fill in. NEVER COMMIT THE RESULT.

# ---- Where this service is reachable ----------------------------------------
# Meta, Infobip and Google all need an absolute URL, and the Google OAuth
# redirect is derived from it. On Render this is the service URL.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated CORS allowlist. Both spellings of the dev server are listed
# because a browser treats them as different origins. Add the Vercel domain
# once the app is deployed.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ---- Persistence --------------------------------------------------------------
# The Supabase project holding voice_tenants and voice_calls. The service key
# bypasses row-level security and must never reach a browser.
#
# Leave both blank and rows go to data/local-store.json instead, which is how
# the stack runs on a laptop with nothing installed. /health says which is live.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Credential encryption ----------------------------------------------------
# AES-256-GCM key for customer credentials at rest. Use the SAME value as
# Conversation-Agent's voice/secretBox.ts, or neither service can read what the
# other sealed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDENTIALS_SECRET=

# ---- Platform admin -----------------------------------------------------------
# Presented as X-Admin-Key to register and edit companies. Blank DISABLES those
# routes rather than leaving them open.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ---- Firebase (sign-in) ---------------------------------------------------------
# Who a person is, separate from which company's API key they end up holding.
# Set ONE of these. A file is the natural choice locally (the console-
# downloaded key is picked up automatically from ../google/calling-agent/ next
# to this repo, so this can usually stay blank on a laptop); the JSON itself is
# the natural choice on a host where nothing survives a redeploy except what
# is configured here. Paste the whole downloaded file's contents as one value
# — Render's env editor accepts multi-line values.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Google Drive -------------------------------------------------------------
# The platform's OAuth *client*. Each company then connects its own Drive, and
# its recordings go to its own account under its own quota. The authorised
# redirect URI must be exactly <PUBLIC_BASE_URL>/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Voice agent ---------------------------------------------------------------
# Configured, and not yet used: the engine that carries call audio is the one
# piece this build does not have.
GEMINI_API_KEY=

# ---- Your own WhatsApp number --------------------------------------------------
# Optional. Read only when no tenant row matches the incoming phone_number_id,
# so your own line works without registering yourself as a customer. Leave blank
# on a fresh install.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Expands a number typed in national form into E.164, for your number only.
# Each company sets its own; there is no shared default.
DEFAULT_COUNTRY_CODE=

# ---- Your own carrier account ---------------------------------------------------
# Optional, same reasoning. A customer without their own Infobip key cannot
# place a call: falling back here would put their minutes on your bill.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
