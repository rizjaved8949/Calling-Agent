# Calling Agent API — platform settings.
#
# NOTHING here is a customer's credential. Each company's WhatsApp token, app
# secret, Infobip key and Google refresh token live in their tenant row, sealed
# with CREDENTIALS_SECRET. That is what makes onboarding a customer a form in
# the app rather than an env edit and a redeploy.
#
# Copy to .env and fill in. Never commit the result.

# ---- Service ---------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated CORS allowlist. The frontend dev server by default.
FRONTEND_URL=http://localhost:5173
# Where this service is reachable from the internet. Meta, Infobip and Google
# all need an absolute URL, and the Google redirect is derived from it.
PUBLIC_BASE_URL=

# ---- Persistence (required) -------------------------------------------------
# The service key bypasses row-level security. It must never reach a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=call-recordings
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
SUPABASE_MAX_UPLOAD_BYTES=52428800

# ---- Credential encryption (required before real customers) ------------------
# AES-256-GCM key material for tenant credentials at rest. Interoperable with
# Conversation-Agent's voice/secretBox.ts — use the SAME value in both, or
# neither service can read what the other wrote.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDENTIALS_SECRET=

# ---- Platform admin ---------------------------------------------------------
# Presented as X-Admin-Key to onboard and edit companies. Blank DISABLES the
# admin routes rather than leaving them open.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ---- Recording --------------------------------------------------------------
RECORDINGS_DIR=data/recordings
# 24 kHz mono MP3. Needs ffmpeg on the host; without it audio is stored exactly
# as it arrived, which means much larger files and no seeking in the player.
TRANSCODE_RECORDINGS=true
TRANSCODE_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=209715200
RECORDING_UPLOAD_WINDOW_SECONDS=3600

# ---- Google -----------------------------------------------------------------
# The platform's OAuth *client*. Each company then connects its own Drive, and
# its recordings are written into its own account.
# Authorised redirect URI must be exactly: <PUBLIC_BASE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_DRIVE_FOLDER_NAME=Calling Agent
GOOGLE_SHEET_SYNC=true
GOOGLE_SHEET_SYNC_DELAY_SECONDS=20

# ---- Reports ----------------------------------------------------------------
EXCEL_FILENAME=Call_Records.xlsx

# ---- Telephony fallback -----------------------------------------------------
# Used only by a company that has not set its own Infobip credentials.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=

# ---- Legacy single-tenant fallback ------------------------------------------
# Only read when no tenant row matches the incoming phone_number_id. Lets a
# pre-SaaS deployment keep answering while its number is moved into the
# registry. Leave blank on a new install.
META_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Expands a number typed in national form into E.164. Blank on purpose: in a
# multi-tenant service a shared default would dial a UK "07…" as Pakistani.
DEFAULT_COUNTRY_CODE=
