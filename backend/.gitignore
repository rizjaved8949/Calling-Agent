.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
data/

# Local server logs from a probe run
live.log
live.err

# Anything shaped like an env file holds the real credentials, whatever it is
# called — a backup, a copy made to paste into a host, a dated snapshot. One
# of these was very nearly committed, so the rule is the shape, not the name.
.env*
# Except the one that exists to be read: names only, no values.
!.env.example
